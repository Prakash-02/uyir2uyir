# U2U Backend Environment Configuration Template
# Copy this file to .env for local development

# Operational Mode ('demo' connects to 'u2u-demo', 'live' connects to 'u2u-live')
DATA_MODE=demo

# Google Cloud Platform Project & Firestore
GOOGLE_CLOUD_PROJECT=u2u-project-placeholder
FIRESTORE_DB=u2u-demo

# Vertex AI & Gemini
VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.0-flash

# Security & Secret Keys
LINK_SIGNING_KEY=placeholder-secret-link-signing-key-for-local-dev
INTERNAL_TOKEN=placeholder-internal-token-for-clock-cron
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173

# Telephony Allowlist & Rate Limits
# Comma-separated list of test numbers permitted to receive outbound calls
CALL_ALLOWLIST=+919876543210,+919876543211
DAILY_CALL_CAP=30
REQUEST_CALL_CAP=15
DAILY_GEMINI_CAP=2000

# Twilio Voice API (Optional for local simulator mode; required for live outreach)
TWILIO_ACCOUNT_SID=AC_placeholder_account_sid
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_FROM_NUMBER=+15551234567
