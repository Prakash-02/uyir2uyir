# ==============================================================================
# Uyir2Uyir (U2U) Production / Staging Environment Configuration Template
# Copy this file to frontend/.env.production.local and provide your real values.
# NEVER commit frontend/.env.production.local or secrets to git.
# ==============================================================================

# Mode must be set to "http" for live deployment connecting to Cloud Run
VITE_API_MODE=http

# Full HTTPS URL of deployed FastAPI backend on Cloud Run (no trailing slash)
VITE_API_BASE_URL=https://u2u-api-demo-3esyvkg5jq-el.a.run.app

# Target Firestore database ID (e.g. u2u-demo)
VITE_FIRESTORE_DB=u2u-demo

# Firebase Web App client configuration (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=AIzaSy_placeholder_key_here
VITE_FIREBASE_AUTH_DOMAIN=uyir2uyir-53929.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=uyir2uyir-53929
VITE_FIREBASE_STORAGE_BUCKET=uyir2uyir-53929.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
